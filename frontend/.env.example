# Base URL of the SatQuery AI FastAPI backend.
# Defaults to http://localhost:8000 when unset (matches `uv run fastapi dev main.py`).
VITE_API_BASE_URL=http://localhost:8000

# Public URL the site is served from, with no trailing slash. Link previews
# (og:image, og:url) need it absolute; unset, they fall back to relative paths.
VITE_SITE_URL=https://satquery.example.pages.dev
