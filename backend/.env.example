# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Vision-language model used for image reasoning. Must accept image input.
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free

# Model used to classify the query into a task. Defaults to the vision model.
# OPENROUTER_ROUTER_MODEL=google/gemma-4-31b-it:free

# Upload and inference limits.
# MAX_IMAGE_BYTES=20971520
# MAX_IMAGE_EDGE_PX=1280
# OPENROUTER_TIMEOUT_S=120

# Indic <-> English translation (IndicTrans2). The checkpoints are gated: accept
# the licence on both model pages on huggingface.co, then paste a read token here.
HF_TOKEN=
# TRANSLATION_ENABLED=true
# TRANSLATION_DEVICE=auto
# TRANSLATION_PRELOAD=false
# TRANSLATION_BEAMS=5
# TRANSLATION_BATCH_SIZE=16
# INDICTRANS_INDIC_EN_MODEL=ai4bharat/indictrans2-indic-en-dist-200M
# INDICTRANS_EN_INDIC_MODEL=ai4bharat/indictrans2-en-indic-dist-200M

# Comma-separated origins allowed to call the API.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
