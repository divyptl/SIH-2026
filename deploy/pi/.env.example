# Copy to ~/satquery/.env on the Pi, next to compose.yaml, and fill in. Never commit it.

# Private model repo with the checkpoints (deploy/upload_weights.py).
WEIGHTS_REPO=prayag17/satquery-weights

# Hugging Face read token: reads WEIGHTS_REPO and the gated IndicTrans2 models
# (the token in backend/.env works).
HF_TOKEN=

# /api/analyse answers 503 without it, even though the specialists never use it.
OPENROUTER_API_KEY=

# The web app's origin.
CORS_ORIGINS=https://satquerymindcraft.pages.dev

# Optional: VLM rewording of change-VQA answers (as in backend/.env).
NARRATION_ENABLED=true
# Optional: fewer beams translate faster on CPU (default 5).
# TRANSLATION_BEAMS=2
